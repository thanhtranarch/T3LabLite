{
  "_doc": "What lite_guard protects. markers: Lite-only code that must stay in a file shared with t3lab_dev (regex, re.M). lite_only: paths sync_from_dev.py never copies. ignore_imports: broken imports that were already there, so they do not fail every check. tools: every ribbon folder that ships -- refresh with `python lite_guard/guard.py --update` after adding or removing a tool on purpose.",
  "markers": [
    {
      "file": "lib/tracking/service.py",
      "pattern": "^\\s+def record_tool_usage\\(",
      "why": "usage tracking service (ribbon + startup rows)"
    },
    {
      "file": "lib/tracking/service.py",
      "pattern": "^\\s+def record_mcp_call\\(",
      "why": "usage tracking service (MCP rows)"
    },
    {
      "file": "lib/tracking/hooks.py",
      "pattern": "^def track_session_start\\(",
      "why": "session start tracking entry point"
    },
    {
      "file": "lib/tracking/hooks.py",
      "pattern": "^def track_ribbon_click\\(",
      "why": "ribbon click tracking entry point"
    },
    {
      "file": "lib/tracking/hooks.py",
      "pattern": "^def track_mcp_call\\(",
      "why": "MCP tool call tracking entry point"
    },
    {
      "file": "lib/tracking/__init__.py",
      "pattern": "^from tracking\\.hooks import",
      "why": "`from tracking import track_...` at the call sites needs these re-exports"
    },
    {
      "file": "startup.py",
      "pattern": "^\\s+track_session_start\\(\\)",
      "why": "startup.py must call track_session_start() on every Revit start"
    },
    {
      "file": "startup.py",
      "pattern": "^\\s+start_auto_update\\(\\)",
      "why": "startup.py must start the weekly auto-update, or users have to click Check Update to get new versions"
    },
    {
      "file": "startup.py",
      "pattern": "^\\s+notify_retired\\(retire_old_ribbon_folders\\(\\)\\)",
      "why": "startup.py must retire the ribbon folders a copy-over update left behind, or zip-updated users see the old panels twice"
    },
    {
      "file": "lib/_cpython_bootstrap.py",
      "pattern": "^\\s+track_ribbon_click\\(\\)",
      "why": "init_cpython_paths() must call track_ribbon_click(), or no ribbon clicks reach the dashboard"
    },
    {
      "file": "lib/core/server.py",
      "pattern": "^def _record_mcp_telemetry\\(",
      "why": "MCP tool call tracking helper"
    },
    {
      "file": "lib/core/server.py",
      "pattern": "^\\s+track_mcp_call\\(",
      "why": "_record_mcp_telemetry() must call tracking.track_mcp_call()"
    },
    {
      "file": "lib/core/server.py",
      "pattern": "^\\s+_record_mcp_telemetry\\(tool_name",
      "min_count": 2,
      "why": "_handle_tool_call() must record MCP calls on both the success and the error path"
    },
    {
      "file": "lib/core/updater.py",
      "pattern": "^GITHUB_REPO\\s*=\\s*['\"]thanhtranarch/T3LabLite['\"]",
      "why": "Check Update must pull from the T3LabLite repo, not t3lab_dev"
    },
    {
      "file": "startup.py",
      "pattern": "^\\s+state, detail = install_whats_new\\(_revit_handle\\(\\)\\)",
      "why": "startup.py must arm the once-per-version \"What's new\" popup (lib/core/whats_new.py)"
    },
    {
      "file": "lib/core/updater.py",
      "pattern": "^from core\\.whats_new import extract_whats_new",
      "why": "Check Update and the What's new popup share one CHANGELOG parser"
    },
    {
      "file": "lib/core/mcp_policy.py",
      "pattern": "^def check_call\\(",
      "why": "MCP security policy for external clients (read-only mode, consent, code execution)"
    },
    {
      "file": "lib/core/server.py",
      "pattern": "^\\s+decision, message, confirm = self\\._external_policy_check\\(",
      "why": "_handle_tool_call() must run every external MCP call through core.mcp_policy, or destructive tools and send_code_to_revit run unasked"
    },
    {
      "file": "lib/core/server.py",
      "pattern": "^\\s+refusal = _ask_user_to_confirm\\(task\\)",
      "why": "the ExternalEvent handler must ask in Revit before a call that needs consent"
    },
    {
      "file": "lib/core/server.py",
      "pattern": "^\\s+if mcp_policy\\.tool_visible\\(name, policy, read_only\\)",
      "why": "tools/list must hide what the MCP policy does not allow"
    },
    {
      "file": "lib/core/file_watcher.py",
      "pattern": "^\\s+def start_if_enabled\\(",
      "why": "the file task watcher runs code with no token, so it may only auto-start when opted in"
    },
    {
      "file": "startup.py",
      "pattern": "^\\s+get_task_watcher\\(\\)\\.start_if_enabled\\(\\)",
      "why": "startup.py must not start the file task watcher unless the user opted in"
    },
    {
      "file": "lib/tracking/service.py",
      "pattern": "^\\s+arguments = redact_arguments\\(arguments\\)",
      "why": "MCP telemetry must never send code, secrets or full paths"
    },
    {
      "file": "lib/core/server.py",
      "pattern": "^\\s+mcp_wiki\\.TOOL_NAME: mcp_wiki\\.TOOL_SCHEMA,",
      "why": "the MCP server must register t3lab_wiki, or AI apps never see the construction wiki and drawing rules (lib/core/mcp_wiki.py)"
    },
    {
      "file": "lib/core/server.py",
      "pattern": "^\\s+instructions=mcp_policy\\.SERVER_INSTRUCTIONS\\)",
      "why": "initialize and server/discover must tell AI apps to read the drawing rules (t3lab_wiki) before drawing work"
    },
    {
      "file": "lib/core/bridge.py",
      "pattern": "^\\s+'instructions': SERVER_INSTRUCTIONS,",
      "why": "the bridge answers initialize itself, so it must send the same instructions as the server"
    },
    {
      "file": "lib/Intelligence/skills/drawing-completion-rules.md",
      "pattern": "^name: drawing-completion-rules$",
      "why": "the MCP instructions and the t3lab_wiki description send AI apps to this page first"
    }
  ],
  "lite_only": [
    ".github",
    ".gitignore",
    "CHANGELOG.md",
    "README.md",
    "T3Lab.tab/Support.panel/Settings.pulldown/MCPControl.pushbutton",
    "extension.json",
    "lib/GUI/MCPControlDialog.py",
    "lib/GUI/Tools/MCPControl.xaml",
    "lib/GUI/assistant",
    "lib/Intelligence/memory_hub.py",
    "lib/Intelligence/remote_mcp.py",
    "lib/Services/mcp_service.py",
    "lib/core/bridge.py",
    "lib/core/call_summary.py",
    "lib/core/file_watcher.py",
    "lib/core/mcp_ipy_host.py",
    "lib/core/mcp_policy.py",
    "lib/core/mcp_prompts.py",
    "lib/core/mcp_wiki.py",
    "lib/core/ribbon_retire.py",
    "lib/core/server.py",
    "lib/core/teaching.py",
    "lib/core/update_schedule.py",
    "lib/core/updater.py",
    "lib/core/whats_new.py",
    "lib/tracking",
    "lite_guard",
    "version.txt"
  ],
  "ignore_imports": [
    {
      "file": "lib/Services/SheetManager/sheet_core/main_window.py",
      "module": "ui.sheet_list_tab",
      "why": "known before lite_guard: main_window.py is not imported anywhere and ui/sheet_list_tab.py has never been in this repo"
    }
  ],
